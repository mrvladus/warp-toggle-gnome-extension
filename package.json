{
  "name": "warp-toggle-gnome-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./build",
    "build:install": "./build install",
    "build:uninstall": "./build uninstall",
    "build:zip": "./build zip",
    "test": "node --loader ./test/gi-loader.js --test test/*.test.js",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "./build install && WARP_CLI=$(pwd)/mock-warp-cli dbus-run-session -- gnome-shell --devkit",
    "dev:real": "./build install && dbus-run-session -- gnome-shell --devkit",
    "prefs": "gnome-extensions prefs warptoggle@mrvladus.github.io",
    "mock:show": "./mock-warp-cli show",
    "mock:connected": "./mock-warp-cli set-state connected",
    "mock:disconnected": "./mock-warp-cli set-state disconnected",
    "mock:connecting": "./mock-warp-cli set-state connecting",
    "mock:disabled": "./mock-warp-cli set-state disabled",
    "mock:no_route": "./mock-warp-cli set-state no_route",
    "mock:offline": "./mock-warp-cli set-state offline",
    "mock:error": "./mock-warp-cli set-state error",
    "mock:not_registered": "./mock-warp-cli set-state not_registered",
    "mock:org": "./mock-warp-cli set-org",
    "mock:personal": "./mock-warp-cli set-personal",
    "mock:clear-reg": "./mock-warp-cli clear-registration",
    "mock:delay": "./mock-warp-cli set-delay",
    "mock:no-delay": "./mock-warp-cli set-delay 0",
    "prepare": "husky"
  },
  "dependencies": {
    "@girs/gjs": "^4.0.0-beta.39",
    "@girs/gnome-shell": "^49.1.0"
  },
  "devDependencies": {
    "@eslint/json": "^1.0.1",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1"
  }
}
