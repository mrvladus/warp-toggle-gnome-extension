{
  "name": "warp-toggle-gnome-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./build zip",
    "build:install": "./build install",
    "build:uninstall": "./build uninstall",
    "build:zip": "./build zip",
    "lint": "eslint extension.js metadata.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "./build install && WARP_CLI=$(pwd)/mock-warp-cli dbus-run-session -- gnome-shell --devkit",
    "prepare": "husky"
  },
  "dependencies": {
    "@girs/gjs": "^4.0.0-beta.39",
    "@girs/gnome-shell": "^49.1.0"
  },
  "devDependencies": {
    "@eslint/json": "^1.0.1",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1"
  }
}
